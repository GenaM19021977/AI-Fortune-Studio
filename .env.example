# =============================================================================
# AI Fortune Studio — шаблон переменных для ЛОКАЛЬНОЙ разработки
# Скопируйте в .env и заполните значения:  copy .env.example .env
# Файл .env НЕ коммитится в git.
# =============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-secret-change-me
DEBUG=True
DATABASE_URL=postgres://fortune:fortune@localhost:5433/fortune
# True — SQLite без Docker (только для ранних шагов 0.3–0.5); False — PostgreSQL
USE_SQLITE=False
REDIS_URL=redis://localhost:6379/0

# --- URLs (localhost) ---
API_URL=http://localhost:8000
# Кнопка Mini App в боте. Для телефона (шаг 0.9) — HTTPS туннеля:
#   .\scripts\Start-Tunnel.ps1  → подставит https://….trycloudflare.com или ngrok
WEBAPP_URL=http://localhost:5173
# После туннеля скрипт добавит origin сам; web.telegram.org — для TWA
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://web.telegram.org

# --- Telegram ---
# Токен от @BotFather — нужен с шага 0.7 (бот)
BOT_TOKEN=your_bot_token_from_botfather

# --- AI (опционально на старте — работает fallback без ключа) ---
GROQ_API_KEY=

# --- Локальные медиафайлы (путь относительно backend/: backend/media/) ---
MEDIA_ROOT=media

# --- Dev-only: обход Telegram auth в браузере (только DEBUG=True) ---
# Заголовок: X-Dev-User-Id: 1  →  GET /api/v1/me/
ENABLE_DEV_AUTH=True

# Срок жизни initData (секунды). 86400 = 24 часа
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Дневной лимит free-генераций (пока заглушка в /me/)
FREE_DAILY_LIMIT=5

# --- Frontend (Vite): mock Telegram на localhost — см. также frontend/.env.example ---
# VITE_DEV_MOCK_TELEGRAM=true
