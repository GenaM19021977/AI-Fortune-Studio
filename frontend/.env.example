# Переменные фронтенда (Vite). Скопируйте в frontend/.env при необходимости.
# Значения с префиксом VITE_ попадают в бандл — не кладите сюда секреты.

# Mock Telegram в браузере (true по умолчанию, если переменная не задана)
VITE_DEV_MOCK_TELEGRAM=true

# Пусто = запросы через Vite proxy /api → localhost:8000
# VITE_API_URL=
